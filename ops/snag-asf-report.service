[Unit]
Description=Send minimal ASF status to Snag

[Service]
Type=oneshot
WorkingDirectory=%h/snag
EnvironmentFile=%h/.config/snag/asf-report.env
ExecStart=/usr/bin/node %h/snag/ops/asf-report.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
TimeoutStartSec=25
